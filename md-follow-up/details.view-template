<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>MD Follow-up | รายงานรายละเอียดภายใน NB</title><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 50 50%27%3E%3Crect width=%2750%27 height=%2750%27 rx=%2712%27 fill=%27%2313293b%27/%3E%3Ctext x=%2713%27 y=%2734%27 font-size=%2726%27 fill=%27%2370dacf%27%3EM%3C/text%3E%3C/svg%3E"><style>
:root{font-family:Inter,"Segoe UI","Noto Sans Thai",Tahoma,sans-serif;color-scheme:dark;--bg:#09121f;--panel:#142337;--line:#314258;--fg:#eaf4ff;--mute:#a5b8ce;--teal:#70dacf}*{box-sizing:border-box}html{scroll-behavior:smooth}body{background:radial-gradient(ellipse at 20% -10%,#1a3555,transparent 45%),var(--bg);margin:0;color:var(--fg);font-size:14px}.wrap{max-width:1500px;margin:auto;padding:25px}.head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:23px;border-bottom:1px solid var(--line)}.label{font-size:10px;letter-spacing:.13em;color:var(--teal);font-weight:800}.head h1{margin:8px 0;font-size:clamp(24px,3vw,38px)}.sub,.hint{color:var(--mute);font-size:12px;line-height:1.7}.private{color:#f4cb90;font-size:10px;letter-spacing:.07em;border:1px solid #715a3b;border-radius:999px;padding:9px 11px}.tiles{margin:25px 0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.tile{background:#13243a;text-align:left;border:1px solid #304965;color:var(--fg);padding:17px 13px;border-radius:13px;cursor:pointer;min-height:103px}.tile.sel{border-color:var(--teal);background:#173940;box-shadow:inset 0 2px 0 #70dacf40}.tile:hover{border-color:#76d8d2}.tile small{display:block;color:var(--mute);font-size:11px;margin:7px 0}.tile strong{font-size:28px}.bar{display:flex;flex-wrap:wrap;gap:9px;justify-content:space-between;align-items:end;margin:20px 0}.bar h2{margin:6px 0 3px;font-size:23px}.controls{display:flex;gap:8px;flex-wrap:wrap}.controls input,.controls select{font:inherit;background:#15273b;color:var(--fg);border:1px solid #39536f;padding:10px 11px;border-radius:9px;min-width:165px;max-width:100%}.controls input{min-width:250px}.controls button,.btn{font:inherit;background:#244a5b;color:#def7f3;padding:10px 12px;border:1px solid #427982;border-radius:9px;cursor:pointer;text-decoration:none}.info{border:1px solid #29485b;border-radius:12px;padding:11px 16px;color:#adc6d7;background:#132a37;font-size:12px;line-height:1.8;margin:13px 0 20px}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:14px;background:#101e30}table{width:100%;border-collapse:collapse;text-align:left}th{position:sticky;top:0;background:#1b3149;color:#a7c4dc;font-size:11px;white-space:nowrap}th,td{padding:12px 13px;border-bottom:1px solid #2b3e54;vertical-align:top}tbody tr{cursor:pointer}tbody tr:hover{background:#1a3650}td{font-size:12px;line-height:1.55}td.title{font-weight:650;max-width:370px;min-width:250px}td.owner{min-width:135px}.is-late{color:#ffc0a3}.is-done{color:#8edcbb}.is-today{color:#f5d498}.tag{font-size:10px;background:#26435b;padding:5px 8px;border-radius:6px;white-space:nowrap}.paging{display:flex;gap:10px;align-items:center;justify-content:flex-end;padding:15px 0}.paging button{color:#cde8f8;background:#172d46;border:1px solid #3e5775;padding:8px 14px;border-radius:7px;cursor:pointer}.paging button:disabled{opacity:.35}aside#detail{margin-top:22px;background:#122238;border:1px solid #39677b;border-radius:16px;padding:22px;scroll-margin-top:18px}aside#detail[hidden]{display:none}.dhead{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}.dhead h3{font-size:23px;margin:8px 0}.dhead button{border:1px solid #45627b;border-radius:8px;background:#1d3149;color:#eee;padding:6px 10px;cursor:pointer}.dgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:19px 0}.dgrid>div{border-left:2px solid #437284;padding:4px 12px}.dgrid b{display:block;color:#a2d5df;margin-bottom:6px;font-size:11px}.dgrid span{font-size:13px;overflow-wrap:anywhere;white-space:pre-wrap}.textnote{white-space:pre-wrap;color:#b5c7d9;font-size:13px;line-height:1.75}aside .steps{max-height:400px;overflow:auto}.steps table th{position:static}.footer{padding:25px 0;color:#7293ab;font-size:11px}.footer a{color:#b9e1f6}button:focus-visible,a:focus-visible{outline:2px solid var(--teal)}@media(max-width:980px){.tiles{grid-template-columns:repeat(3,1fr)}.dgrid{grid-template-columns:1fr 1fr}}@media(max-width:570px){.wrap{padding:15px}.tiles{grid-template-columns:repeat(2,1fr)}.controls input{min-width:100%}.dgrid{grid-template-columns:1fr}.head{display:block}.private{display:inline-block}}
</style></head><body><main class="wrap"><header class="head"><div><div class="label">PRACTIKA / MD CONTROL · PRIVATE NB ONLY</div><h1>ทะเบียนงานติดตาม MD · เจาะรายละเอียด</h1><div class="sub">ข้อมูลจาก CB, ICS, ICF, ICE, นวัตกรรม และ Planner · อ่านอย่างเดียว · ไม่แก้ไขไฟล์ต้นทาง</div></div><div class="private">LOCALHOST · 127.0.0.1 · ไม่เผยแพร่ GitHub</div></header>
<div style="padding:15px 0"><a class="btn" style="display:inline-block" href="./pivot.html">เปิด Pivot Report — เรียง Due / Stage / เจ้าภาพ / แผนก ↗</a></div><div id="tiles" class="tiles" aria-label="เลือกกลุ่ม"></div><section class="bar"><div><div class="label">WORK ITEM EXPLORER</div><h2 id="groupName">Loading...</h2><div id="groupCount" class="sub"></div></div><div class="controls"><input id="search" type="search" placeholder="ค้นชื่องาน, Order, เจ้าภาพ…" aria-label="ค้นรายการ"><select id="status" aria-label="สถานะ"><option value="">ทุกสถานะ</option></select><select id="late" aria-label="กำหนดส่ง"><option value="">ทุกกำหนด</option><option value="ผ่านกำหนดในตาราง">วันกำหนดผ่านแล้ว</option><option value="ครบกำหนดวันนี้">ครบกำหนดวันนี้</option><option value="ไม่ระบุวัน">ไม่ระบุวัน</option></select></div></section>
<div id="notice" class="info"></div><div class="tablewrap"><table><thead><tr><th>รหัส / แถว</th><th>รายการ / ขั้นตอน</th><th>สถานะ</th><th>เจ้าภาพ / ผู้รับผิดชอบ</th><th>วันที่ในตาราง</th><th>ความตรงเวลา</th></tr></thead><tbody id="rows"></tbody></table></div><div class="paging"><span id="pageInfo" class="sub"></span><button id="prev">← ก่อนหน้า</button><button id="next">ถัดไป →</button></div>
<aside id="detail" hidden></aside><div class="footer">เฉพาะ Notebook เครื่องนี้ · ข้อมูล Planner และนวัตกรรมเป็น Snapshot ตามเวลาที่ระบุ · งาน ICS/ICF/ICE ไม่คำนวณ Overdue จากช่องวันที่เสร็จ · <a href="https://popvarachat.github.io/md-follow-up/" rel="noopener" target="_blank">กลับ Executive Dashboard ↗</a></div></main>
<script>
"use strict";
const esc=x=>String(x==null?"":x).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const labels={cb:"Check Board",ics:"ICS",icf:"ICF",ice:"ICE / EDU",innovation:"Innovation",planner:"Monitor Coordinator / Planner"};
const desc={cb:"วันที่โอนเทียบกับ 19 ต.ค. ต้องตรวจหลักฐานโอนจริงก่อนสรุปว่าล่าช้า",ics:"แสดงระดับ Gate · คอลัมน์วันที่เป็นวันที่ในตาราง ไม่ยืนยันว่าเป็น Due Date",icf:"แสดงระดับ Gate · คอลัมน์วันที่เป็นวันที่ในตาราง ไม่ยืนยันว่าเป็น Due Date",ice:"แสดงระดับ Gate · คอลัมน์วันที่เป็นวันที่ในตาราง ไม่ยืนยันว่าเป็น Due Date",innovation:"โครงการจากไฟล์สำเนา SharePoint บน NB อาจช้ากว่าไฟล์ออนไลน์ และยอดหัวโครงการยังต้องกระทบยอดกับ Dashboard 98",planner:"แสดงงานจากการดึง Connector ล่าสุด · ฟิลด์ Assignment ไม่ได้แปลงรหัสผู้ใช้เป็นชื่อบุคคลโดยอัตโนมัติ"};
let data=null,current="cb",page=0,matched=[],selectId=null;const size=45,$=id=>document.getElementById(id);
function rows(){return data?.sources?.[current]?.rows||[]}
function renderTiles(){const names=Object.keys(labels).filter(k=>data.sources[k]);$("tiles").innerHTML=names.map(k=>'<button class="tile '+(k===current?"sel":"")+'" data-source="'+k+'" aria-pressed="'+(k===current)+'"><div class="label">'+esc(labels[k])+'</div><strong>'+data.sources[k].count.toLocaleString("th-TH")+'</strong><small>'+esc(k==="innovation"?"โครงการ":k==="planner"?"งาน":k==="cb"?"Orders":"Gate rows")+' · เปิดดู ↗</small></button>').join("");}
function setGroup(k){if(!data.sources[k])return;current=k;page=0;selectId=null;$("detail").hidden=true;$("search").value="";$("status").value="";$("late").value="";renderTiles();filterRows();history.replaceState(null,"","?source="+k);}
function filterRows(){const q=$("search").value.trim().toLocaleLowerCase(),st=$("status").value,late=$("late").value;
 matched=rows().filter(r=>(!st||r.status===st)&&(!late||r.timeliness===late)&&(!q||[r.id,r.title,r.owner,r.status,r.reference,r.parent,r.notes].join(" ").toLocaleLowerCase().includes(q)));
 const counts={};rows().forEach(r=>counts[r.status]=(counts[r.status]||0)+1);
 $("status").innerHTML='<option value="">ทุกสถานะ</option>'+Object.entries(counts).sort((a,b)=>b[1]-a[1]).map(([k,n])=>'<option value="'+esc(k)+'">'+esc(k)+' ('+n+')</option>').join("");
 if(st)$("status").value=st;
 const order={"ผ่านกำหนดในตาราง":0,"ครบกำหนดวันนี้":1,"ยังไม่ถึงกำหนด":2,"ไม่ระบุวัน":3,"ไม่ยืนยันกำหนด":4,"ปิดตามสถานะ":5};
 matched.sort((a,b)=>(order[a.timeliness]??3)-(order[b.timeliness]??3));
 renderRows();}
function renderRows(){$("groupName").textContent=labels[current];$("groupCount").textContent=matched.length+" / "+rows().length+" รายการ";
 $("notice").textContent=desc[current]+(data.warnings?.length?" · มีข้อจำกัดแหล่งข้อมูล "+data.warnings.length+" รายการ":"")+" · สร้างข้อมูลภายใน "+new Date(data.generated_at).toLocaleString("th-TH");
 const chunk=matched.slice(page*size,(page+1)*size);
 $("rows").innerHTML=chunk.map((r,i)=>'<tr data-index="'+(page*size+i)+'"><td>'+esc(r.id)+'</td><td class="title">'+esc(r.title)+'</td><td><span class="tag">'+esc(r.status)+'</span></td><td class="owner">'+esc(r.owner)+'</td><td>'+esc(r.due)+'<div class="sub">'+esc(r.due_kind)+'</div></td><td class="'+(r.timeliness.includes("ผ่าน")?"is-late":r.timeliness.includes("ครบกำหนด")?"is-today":r.timeliness.includes("ปิด")?"is-done":"")+'">'+esc(r.timeliness)+'</td></tr>').join("");
 $("pageInfo").textContent=matched.length?((page*size+1)+"–"+Math.min((page+1)*size,matched.length)+" / "+matched.length):"ไม่พบรายการ";
 $("prev").disabled=page<=0;$("next").disabled=(page+1)*size>=matched.length;}
function showRecord(r){selectId=r.id;$("detail").hidden=false;const notes=[r.notes,r.customer?"ลูกค้า/โครงการ: "+r.customer:"",r.reference?"Reference: "+r.reference:""].filter(Boolean).join("\n");
 let steps="";
 if(r.steps?.length){steps='<h4>ขั้นตอนย่อย ('+r.steps.length+')</h4><div class="steps"><table><thead><tr><th>แถว</th><th>ขั้นตอน</th><th>สถานะ</th><th>เจ้าภาพ</th><th>กำหนด</th></tr></thead><tbody>'+r.steps.map(s=>'<tr><td>'+esc(s.row)+'</td><td>'+esc(s.task)+'</td><td>'+esc(s.status)+'</td><td>'+esc(s.owner||"ไม่ระบุ")+'</td><td>'+esc(s.due)+'</td></tr>').join("")+'</tbody></table></div>'}
 $("detail").innerHTML='<div class="dhead"><div><div class="label">RECORD DETAIL / '+esc(labels[current])+'</div><h3>'+esc(r.title)+'</h3><div class="sub">'+esc(r.id)+" · "+esc(r.reference)+" · "+esc(r.parent)+'</div></div><button id="closeDetail">ปิด ✕</button></div><div class="dgrid"><div><b>สถานะปัจจุบันที่บันทึก</b><span>'+esc(r.status)+'</span></div><div><b>เจ้าภาพ</b><span>'+esc(r.owner)+'</span></div><div><b>วันที่ / ความตรงเวลา</b><span>'+esc(r.due||"ไม่มี")+" · "+esc(r.timeliness)+'</span></div></div><div class="textnote">'+esc(notes||"ไม่มีหมายเหตุเพิ่มเติม")+'</div>'+steps;
 $("closeDetail").addEventListener("click",()=>$("detail").hidden=true);$("detail").scrollIntoView({behavior:"smooth",block:"start"});}
$("tiles").addEventListener("click",e=>{const b=e.target.closest("[data-source]");if(b)setGroup(b.dataset.source)});
$("rows").addEventListener("click",e=>{const tr=e.target.closest("tr[data-index]");if(tr)showRecord(matched[+tr.dataset.index])});
$("search").addEventListener("input",()=>{page=0;filterRows()});
$("status").addEventListener("change",()=>{page=0;filterRows()});
$("late").addEventListener("change",()=>{page=0;filterRows()});
$("prev").addEventListener("click",()=>{page=Math.max(0,page-1);renderRows()});
$("next").addEventListener("click",()=>{page++;renderRows()});
fetch("./records.json?x="+Date.now(),{cache:"no-store"}).then(r=>{if(!r.ok)throw Error("Data HTTP "+r.status);return r.json()}).then(j=>{data=j;const p=new URLSearchParams(location.search).get("source");if(p&&data.sources[p])current=p;setGroup(current)}).catch(e=>{$("groupName").textContent="ไม่สามารถโหลดรายละเอียด";$("notice").textContent=e.message});
</script></body></html>