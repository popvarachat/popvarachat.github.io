;width:100%}label.check{display:flex;gap:8px;align-items:center;font-size:11px;color:#bcd2e2;padding:9px;border:1px solid #35516a;border-radius:8px}.check input{min-width:unset;min-height:unset;accent-color:#75d8cc}.aside{font-size:11px;color:#a8c4d3;line-height:1.65;margin:12px 0}.modes{display:flex;flex-wrap:wrap;gap:6px}.headbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:14px}.headbar h2{font-size:20px;margin:0}.breakdown{display:flex;flex-wrap:wrap;gap:12px;margin:8px 0}.breakdown div{background:#182e44;padding:9px 12px;border-radius:8px;font-size:12px;color:#b5d2e4}.breakdown b{font-size:17px;color:#e2f0fb;display:block}.tablewrap{overflow:auto;border:1px solid #36516a;border-radius:11px;max-height:675px}table{width:100%;border-collapse:collapse;text-align:left}th{background:#1c354f;color:#c0d6e7;white-space:nowrap;font-size:11px;position:sticky;top:0;z-index:2}th,td{padding:11px 12px;border-bottom:1px solid #284057;vertical-align:top}tbody tr[data-r]{cursor:pointer}tbody tr[data-r]:hover{background:#1a3848}td{font-size:12px;line-height:1.6}td.work{min-width:280px;max-width:380px;font-weight:700}td.stage{min-width:230px;max-width:320px}td.deadline{white-space:nowrap}td.owner{min-width:140px}td small{font-size:10px;font-weight:500;color:#8da8bd;display:block}.badge{display:inline-block;border-radius:6px;background:#23475c;color:#c5e5e9;padding:4px 7px;font-size:10px}.overdue{color:#ffb1a3}.unverified{color:var(--gold)}.done{color:#9bdac9}.empty{padding:30px;text-align:center;color:var(--muted)}.groupRow td{background:#172c40;color:#b8d7e9;font-weight:800;letter-spacing:.015em}.pager{display:flex;gap:12px;align-items:center;justify-content:flex-end;margin-top:14px;color:#a1b9c9;font-size:11px}.pager button,.drawer button{border:1px solid #41637e;border-radius:8px;background:#224059;color:#e7f5ff;padding:9px 13px;cursor:pointer}.pager button:disabled{opacity:.3}.drawer{border:1px solid #4c8a92;border-radius:16px;background:#142b3d;margin:16px 0;padding:20px;scroll-margin-top:20px}.drawer[hidden]{display:none}.drawer-top{display:flex;gap:14px;align-items:flex-start;justify-content:space-between}.drawer h3{font-size:22px;margin:7px 0}.drawer .crumb{color:#96b5c8;font-size:11px}.steps{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin:19px 0}.step{background:#102336;padding:13px 14px;border:1px solid #2b4760;border-radius:11px;border-top:2px solid #537a97}.step.focus{border-color:#8edfd1;border-top-color:#8edfd1;background:#183d42}.step .idx{font-size:10px;color:#88cfcc;font-weight:800}.step strong{display:block;font-size:12px;margin:9px 0;line-height:1.5}.step p{color:#a7c1d2;font-size:11px;line-height:1.6;margin:5px 0}.stageflag{margin-top:7px;font-size:10px;color:#efd1a3}.summary{font-size:11px;color:#98b7ca;margin-top:15px;line-height:1.7}.pivotRow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:11px 4px;border-bottom:1px solid #2b4059}.pivotRow strong{min-width:180px;flex:1}.pivotRow span{font-size:11px;color:#a2b9c9}.meter{height:6px;min-width:60px;flex:4;background:#263c51;border-radius:15px;overflow:hidden}.meter i{display:block;height:100%;background:#70cdc7;border-radius:15px}.hint{padding:11px 13px;background:#1b3442;border:1px solid #35596b;border-radius:9px;color:#a9cdda;font-size:11px;line-height:1.7;margin:13px 0}@media(max-width:1150px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){main{padding:12px}.grid{grid-template-columns:repeat(2,1fr)}.mast{display:block}.return{display:inline-block;margin-top:12px}.panel{padding:12px}}
</style></head><body><main><header class="mast"><div><div class="eyebrow">PRIVATE INTELLIGENCE / STAGE-DUE PIVOT</div><h1>MD Tracking — Pivot by Due &amp; Stage</h1><p class="sub">ดูตามวันที่ต้องส่ง → Stage ที่ยังไม่ผ่าน → คนรับผิดชอบ → แผนก / กลุ่มงาน · คลิกเจาะ Flow ของงานนั้น</p></div><a class="return" href="./?source=cb">← ทะเบียนรายละเอียดทั้งหมด</a></header>
<div class="grid" id="kpis"></div><div class="sources" id="sourceButtons"></div>
<section class="panel"><div class="filters"><label class="field search"><span>ค้นหา Work / Stage / เจ้าภาพ / Order</span><input id="q" type="search" placeholder="เช่น ราคา, Drawing, ENG, โต๊ะ, MD…"></label><label class="field"><span>ฝ่าย / แผนก</span><select id="dept"><option value="">ทุกฝ่าย</option></select></label><label class="field"><span>สถานะกำหนดส่ง</span><select id="due"><option value="">ทั้งหมด</option><option value="ผ่านกำหนดตามตาราง">เกินวันกำหนดในตาราง</option><option value="ครบกำหนดวันนี้">ครบกำหนดวันนี้</option><option value="ยังไม่ถึงกำหนด">ยังไม่ถึงกำหนด</option><option value="ไม่ได้กำหนด Stage Due">ไม่มี Stage Due รับรอง</option><option value="ไม่มีวันกำหนด">ไม่ระบุวัน</option></select></label><label class="check"><input type="checkbox" id="currentOnly" checked>เฉพาะ Stage ที่ต้องติดตามตอนนี้</label></div><div class="aside" id="contextNote">ข้อมูลภายใน NB เท่านั้น · กำลังโหลด</div></section>
<section class="panel"><div class="headbar"><h2 id="viewTitle">Pivot — กำหนดส่งงาน</h2><div class="modes" id="modes"><button data-mode="due" class="sel">เรียงวันส่ง</button><button data-mode="department">Pivot แยกฝ่าย</button><button data-mode="owner">Pivot แยกผู้รับผิดชอบ</button><button data-mode="stage">Pivot แยก Stage</button></div></div><div id="summary" class="breakdown"></div><div id="matrix" hidden></div><div id="tablePanel"><div class="tablewrap"><table><thead><tr><th>กำหนดส่ง / ลำดับ</th><th>งาน / โครงการ</th><th>Stage ที่ค้าง</th><th>เจ้าของ Stage</th><th>ฝ่าย / หน่วยงาน</th><th>สถานะ</th><th>ความเสี่ยง</th></tr></thead><tbody id="tbody"></tbody></table></div><div class="pager"><span id="paging"></span><button id="previous">← ก่อนหน้า</button><button id="next">ถัดไป →</button></div></div></section>
<div id="drawer" class="drawer" hidden></div><div class="hint" id="method">สำคัญ: วันโอน CB เป็น Target Transfer ไม่ใช่วันที่โอนจริง • ICS/ICF/ICE ไม่พบ Due ของทุก Stage ที่รับรองแล้ว จึงแสดงในกลุ่ม No Stage Due • ผู้รับผิดชอบที่ไม่ระบุแผนกจะไม่เดาแผนกให้</div>
<footer class="summary">Data Security: รายละเอียดและเลข Order อยู่บน NB localhost เท่านั้น ไม่เผยแพร่บน GitHub · ห้ามใช้ตัวเลขแถว Gate เป็นจำนวนคำสั่ง MD ที่ไม่ซ้ำกัน</footer></main><script>
"use strict";const $=id=>document.getElementById(id),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));const names={all:"ทุกกลุ่ม",cb:"Check Board",planner:"Planner",innovation:"นวัตกรรม",ics:"ICS",icf:"ICF",ice:"ICE / EDU"};
let data=[],summary={},source="all",mode="due",filtered=[],page=0,perPage=90,byWork={},current=null,asof="";
const duePriority=x=>x.deadline_state==="ผ่านกำหนดตามตาราง"?0:x.deadline_state==="ครบกำหนดวันนี้"?1:x.deadline_state==="ยังไม่ถึงกำหนด"?2:3;
function sortDue(a,b){const rank=duePriority(a)-duePriority(b);if(rank)return rank;const x=a.due_iso||"9999",y=b.due_iso||"9999";return x.localeCompare(y)||a.source.localeCompare(b.source)||a.project.localeCompare(b.project)||a.stage_index-b.stage_index}
function statusClass(x){return x.deadline_state==="ผ่านกำหนดตามตาราง"?"overdue":x.deadline_state.includes("ไม่")?"unverified":x.closed?"done":""}
function renderKpis(){const active=filtered.filter(r=>!r.closed);const overdue=active.filter(r=>r.deadline_state==="ผ่านกำหนดตามตาราง").length;const today=active.filter(r=>r.deadline_state==="ครบกำหนดวันนี้").length;
 const noDue=active.filter(r=>r.deadline_state==="ไม่ได้กำหนด Stage Due"||r.deadline_state==="ไม่มีวันกำหนด").length;
 const invalid=active.filter(r=>r.department.includes("ยังไม่")||r.department.includes("ไม่ระบุ")).length;
 const u=new Set(active.map(r=>r.work_key)).size;
 const cells=[["งาน / โครงการที่ปรากฏ",u],["Stage ที่ยังเปิด",active.length],["เกินวันกำหนดในตาราง",overdue],["ครบกำหนดวันนี้",today],["ไม่มี Stage Due",noDue],["ยังไม่ยืนยันฝ่าย",invalid]];
 $("kpis").innerHTML=cells.map(([k,v],i)=>'<div class="metric '+(i===2?"danger":i===4||i===5?"warning":"")+'"><div class="eyebrow">'+esc(k)+'</div><strong>'+v.toLocaleString("th-TH")+'</strong><div class="sub">'+(i===2?"ต้องตรวจว่ามีการส่งจริงหรือยัง":i===4?"ต้องตกลง SLA ราย Stage":"ข้อมูลจากทะเบียนที่ตรวจ")+'</div></div>').join("")}
function renderSourceButtons(){let set=Object.keys(summary);const options=["all",...set];$("sourceButtons").innerHTML=options.map(s=>'<button class="'+(s===source?"sel":"")+'" data-source="'+s+'">'+esc(names[s]||s)+' <span>'+ (s==="all"?data.length:summary[s].stages).toLocaleString("th-TH")+'</span></button>').join("")}
function refreshDepts(){const old=$("dept").value;const ar=[...new Set(data.filter(x=>source==="all"||x.source===source).map(r=>r.department))].sort((a,b)=>a.localeCompare(b,"th"));$("dept").innerHTML='<option value="">ทุกฝ่าย</option>'+ar.map(n=>'<option value="'+esc(n)+'">'+esc(n)+'</option>').join("");if(ar.includes(old))$("dept").value=old;}
function filter(){const query=$("q").value.trim().toLocaleLowerCase(),selected=$("dept").value,due=$("due").value,only=$("currentOnly").checked;
 filtered=data.filter(x=>(source==="all"||x.source===source)&&(!only?true:x.is_current_stage&&!x.closed)&&(!selected||x.department===selected)&&(!due||x.deadline_state===due)&&(!query||[x.project,x.stage,x.owner,x.department,x.source,x.work_key,x.row_id].join(" ").toLocaleLowerCase().includes(query))).sort(sortDue);
 page=0;render();}
function render(){renderKpis();renderSourceButtons();$("contextNote").textContent="Snapshot: "+new Date(current.updated).toLocaleString("th-TH")+" • "+"ผลลัพธ์ "+filtered.length.toLocaleString("th-TH")+" ขั้นตอน • "+(source==="all"?"6 กลุ่ม":names[source])+" • รายการจากทะเบียนไม่ใช่งาน MD ไม่ซ้ำกัน";
 const title={due:"กำหนดส่ง / Stage ต่อเนื่อง",department:"Pivot — ฝ่ายที่งานค้างอยู่",owner:"Pivot — ผู้รับผิดชอบ",stage:"Pivot — ขั้นตอนงาน"};$("viewTitle").textContent=title[mode];
 const agg={},open=filtered.filter(x=>!x.closed);
 [["งานที่ยังเปิด",open.length],["เลยกำหนดตามตาราง",open.filter(x=>x.deadline_state==="ผ่านกำหนดตามตาราง").length],["งานที่ไม่ยืนยัน Due",open.filter(x=>x.deadline_state==="ไม่ได้กำหนด Stage Due"||x.deadline_state==="ไม่มีวันกำหนด").length]].forEach(([a,b])=>agg[a]=b);
 $("summary").innerHTML=Object.entries(agg).map(([k,n])=>'<div><b>'+n.toLocaleString("th-TH")+'</b>'+esc(k)+'</div>').join("");
 $("tablePanel").hidden=mode!=="due";$("matrix").hidden=mode==="due";if(mode==="due")renderTable();else renderMatrix();
}
function renderTable(){const rows=filtered.slice(page*perPage,(page+1)*perPage);const chunks=[];let last="";
 for(const [i,r] of rows.entries()){let label=r.due_iso?new Date(r.due_iso+"T12:00:00").toLocaleDateString("th-TH",{day:"numeric",month:"short",year:"numeric"}):"ไม่ระบุ Stage Due";if(r.deadline_state==="ไม่ได้กำหนด Stage Due")label="ต้องกำหนด Stage Due";else if(r.deadline_state==="ไม่มีวันกำหนด")label="ไม่มีวันกำหนดในทะเบียน";
 if(label!==last){last=label;chunks.push('<tr class="groupRow"><td colspan="7">'+esc(label)+'</td></tr>')}
 chunks.push('<tr data-r="'+(page*perPage+i)+'"><td class="deadline">'+esc(r.due||"—")+'<small>'+esc(r.due_quality)+'</small></td><td class="work">'+esc(r.project)+'<small>'+esc(names[r.source]||r.source)+' · '+esc(r.row_id)+'</small></td><td class="stage">'+esc(r.stage)+'<small>Stage '+r.stage_index+'/'+r.stage_total+' · คลิกดูลำดับงาน ↗</small></td><td class="owner">'+esc(r.owner)+'</td><td>'+esc(r.department)+'</td><td><span class="badge">'+esc(r.status)+'</span></td><td class="'+statusClass(r)+'">'+esc(r.deadline_state)+'</td></tr>')}
 $("tbody").innerHTML=chunks.join("")||'<tr><td colspan="7" class="empty">ไม่มีรายการตามเงื่อนไขที่เลือก</td></tr>';$("paging").textContent=(filtered.length?(page*perPage+1)+"–"+Math.min((page+1)*perPage,filtered.length):"0")+" / "+filtered.length;$("previous").disabled=page===0;$("next").disabled=(page+1)*perPage>=filtered.length;}
function renderMatrix(){const name=mode==="department"?"department":mode==="owner"?"owner":"stage",totals={};for(const r of filtered){const key=r[name]||"ไม่ระบุ";if(!totals[key])totals[key]={total:0,overdue:0,missing:0,works:new Set()};const x=totals[key];x.total++;x.works.add(r.work_key);if(r.deadline_state==="ผ่านกำหนดตามตาราง")x.overdue++;if(!r.due_iso)x.missing++}
 const a=Object.entries(totals).sort((a,b)=>b[1].overdue-a[1].overdue||b[1].total-a[1].total).slice(0,60),max=Math.max(1,...a.map(x=>x[1].total));
 $("matrix").innerHTML='<div class="hint">เรียงตามจำนวน Stage ที่ผ่านวันกำหนด (ที่มีหลักฐาน Due) ก่อน · คอลัมน์ Stage ที่ไม่มี Due ยังไม่จัดว่าเลยกำหนด</div>'+a.map(([k,x])=>'<div class="pivotRow"><strong>'+esc(k)+'</strong><span>'+x.works.size+' งาน / '+x.total+' ขั้น</span><span class="'+(x.overdue?"overdue":"")+'">เกินกำหนด '+x.overdue+'</span><span>ขาด Due '+x.missing+'</span><div class="meter"><i style="width:'+(100*x.total/max)+'%"></i></div></div>').join("")}
function openStage(r){const all=(byWork[r.work_key]||[]).slice().sort((a,b)=>a.stage_index-b.stage_index);$("drawer").hidden=false;const nodes=all.map(z=>'<div class="step '+(z.row_id===r.row_id?"focus":"")+'"><div class="idx">STAGE '+z.stage_index+'/'+z.stage_total+' • '+esc(z.source.toUpperCase())+'</div><strong>'+esc(z.stage)+'</strong><p>เจ้าภาพ: '+esc(z.owner)+'</p><p>ฝ่าย: '+esc(z.department)+'</p><p>กำหนด: '+esc(z.due||"ยังไม่รับรอง")+'</p><p>สถานะ: '+esc(z.status)+'</p><div class="stageflag '+statusClass(z)+'">'+esc(z.deadline_state)+'</div></div>').join("");
 $("drawer").innerHTML='<div class="drawer-top"><div><div class="eyebrow">WORKFLOW TRACE / '+esc(names[r.source])+'</div><h3>'+esc(r.project)+'</h3><div class="crumb">'+esc(r.work_key)+' · '+all.length+' ขั้นตอน · ปัจจุบัน: '+esc(r.current_stage_basis)+'</div></div><button id="closeDrawer">ปิด ✕</button></div><div class="steps">'+nodes+'</div><div class="summary">รายการนี้อ้างอิงสถานะต้นทาง หากมี Stage เดียวกันหลายระบบยังไม่รับรองว่าเป็นงานเดียวกันโดยอัตโนมัติ · Due ของ ICS/ICF/ICE ต้องเพิ่มจากข้อมูลที่ได้รับอนุมัติ</div>';$("closeDrawer").onclick=()=>{$("drawer").hidden=true};$("drawer").scrollIntoView({behavior:"smooth",block:"start"})}
$("sourceButtons").onclick=e=>{const b=e.target.closest("[data-source]");if(b){source=b.dataset.source;refreshDepts();filter()}};
$("modes").onclick=e=>{const b=e.target.closest("[data-mode]");if(!b)return;mode=b.dataset.mode;$("modes").querySelectorAll("button").forEach(x=>x.classList.toggle("sel",x===b));render()};
$("tbody").onclick=e=>{const tr=e.target.closest("[data-r]");if(tr)openStage(filtered[+tr.dataset.r])};
["q","dept","due","currentOnly"].forEach(id=>$(id).addEventListener(id==="q"?"input":"change",filter));
$("previous").onclick=()=>{page=Math.max(0,page-1);renderTable()};$("next").onclick=()=>{page++;renderTable()};
fetch("./pivot.json?t="+Date.now(),{cache:"no-store"}).then(r=>{if(!r.ok)throw Error("HTTP "+r.status);return r.json()}).then(j=>{data=j.rows;summary=j.summary;current=j;asof=j.as_of;for(const x of data)(byWork[x.work_key]??=[]).push(x);refreshDepts();filter()}).catch(e=>{$("contextNote").textContent="ไม่สามารถโหลด Pivot: "+e.message});
</script></body></html>